# OS
.DS_Store

# Local-only relational mirror (regenerated each run; the durable history lives in
# data/metrics_history.csv, which IS committed so the CFI series accumulates).
data/warehouse.sqlite

# `site/` is the LOCAL build output of build_site (regenerated every run). The committed,
# Pages-served copy is `docs/` (the workflow commits docs/ each run), so site/ is kept out
# of git to avoid a second, drift-prone copy of the page + the binary memo PNG.
site/

# Editor
.vscode/

# Local Claude tooling / skills (not part of the deliverable)
.claude/

# Local-only temp files (deploy helper + Playwright scratch dir)
.commitmsg.tmp
.pwtmp/
